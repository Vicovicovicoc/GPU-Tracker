# GPU Price Tracker environment variables
#
# Lovable Cloud automatically provides the Supabase connection variables
# for projects connected to Lovable Cloud. You do not need to copy them
# into this file when using the managed Cloud backend.
#
# For local development or deployments outside Lovable Cloud, copy this
# file to .env.local and fill in the values from your Supabase project.

# Public client configuration (safe to expose in the browser)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only secrets. Never add the SERVICE_ROLE key to a VITE_ variable
# or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
FIRECRAWL_API_KEY=
LOVABLE_API_KEY=
BREVO_API_KEY=
